@startuml chatlas_architecture
title Chatlas high-level architecture

package "Telegram" {
  actor "User" as User
  [Telegram Client] as TgClient
  [Telegram Bot API] as TgAPI
}

package "Chatlas Application" {
  [ChatlasApplication] as App

  package "telegram" {
    [ChatlasBot] as Bot
    [ChatProcessingService] as ProcessingService
  }

  package "parser" {
    [ChatExportParser] as Parser
  }

  package "analysis" {
    [ChatAnalyzer] as Analyzer
  }

  package "export" {
    [ReportRenderer] as Renderer
  }

  package "domain" {
    [RawChatFile] as RawFile
    [ChatExport] as ChatExport
    [Participant] as Participant
    [Mention] as Mention
    [ChatAnalysisResult] as AnalysisResult
    [ReportResult] as ReportResult
    [ReportOutputType] as ReportOutputType
  }

  package "config" {
    [BotConfig] as BotConfig
  }
}

User --> TgClient
TgClient --> TgAPI
TgAPI --> Bot : updates

App --> BotConfig
App --> Bot

Bot --> ProcessingService : process file

ProcessingService --> Parser : parse file
Parser --> ChatExport
Parser --> RawFile

ProcessingService --> Analyzer : analyze export
Analyzer --> AnalysisResult
AnalysisResult --> Participant
AnalysisResult --> Mention

ProcessingService --> Renderer : render result
Renderer --> ReportResult : returns
ReportResult --> ReportOutputType
Bot --> ReportResult : uses recommendedType
Bot --> TgAPI : send text/Excel based on recommendedType
TgAPI --> TgClient
TgClient --> User

@enduml
