@startuml flowchart
title File processing flow

start

:Получить файл экспорта\nот Telegram;
if (Файл валиден\nи допустимый формат?) then (yes)
    :Парсинг файлов;
    :Агрегация сообщений\nи пользователей;
    :Фильтрация удалённых\nаккаунтов;
    :Подсчёт количества\nуникальных участников;
    if (Общее число сущностей\n(участники + упоминания) <= 50?) then (yes)
      :Генерация текстового отчета\n(ReportTextResult);
      :Отправка текстового\nсписка пользователю;
    else (no)
      :Генерация Excel-файла\n(ReportExcelResult);
      :Отправка Excel-файла\nпользователю;
    endif
else (no)
  :Ответ об ошибке\n(неподдерживаемый формат/повреждение);
endif

stop
@enduml
