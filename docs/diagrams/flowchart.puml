@startuml flowchart
title File processing flow

start

:Получить файлы экспорта\nот Telegram;
if (Файлы валидны\nи допустимый формат?) then (yes)
  if (Количество файлов\n<= лимита?) then (yes)
    :Парсинг файлов;
    :Агрегация сообщений\nи пользователей;
    :Фильтрация удалённых\nаккаунтов;
    :Подсчёт количества\nуникальных участников;
    if (Общее число сущностей\n(участники + упоминания) < 50?) then (yes)
      :Формирование текстового\nсписка/сообщения;
      :Отправка результата пользователю;
    else (no)
      :Формирование Excel-отчёта\nв памяти;
      :Отправка Excel пользователю;
    endif
  else (no)
    :Ответ об ошибке\n(слишком много файлов);
  endif
else (no)
  :Ответ об ошибке\n(неподдерживаемый формат/повреждение);
endif

stop
@enduml
